// Build settings for all four targets, as a plain clone needs them: no team, automatic signing, an example
// bundle identifier and no server connection. Nothing in this file belongs to one developer.
//
// Do not edit this file to build with your own team. Run ios/scripts/setup.sh: it writes your values to
// Local.xcconfig (not committed), which is included at the end so that it wins. Every value below can be
// set there.

// Apple developer team and the app's bundle identifier: set by ios/scripts/setup.sh.
// The three extensions add .notify, .widgets and .share to the bundle identifier, and the Keychain group
// the app shares with them is <team prefix>.<bundle identifier>.shared (project.yml), so these two values
// move every identifier together. A simulator build needs no team.
T3BOT_TEAM =
T3BOT_BUNDLE_ID = com.example.t3bot

// Signing: set by ios/scripts/setup.sh. Automatic, and Xcode makes the profiles for your team. With
// setup.sh --manual it becomes Manual and the four names below are the provisioning profiles you made.
T3BOT_SIGN_STYLE = Automatic
T3BOT_SIGN_IDENTITY = Apple Development
T3BOT_PROFILE_APP =
T3BOT_PROFILE_NOTIFY =
T3BOT_PROFILE_WIDGETS =
T3BOT_PROFILE_SHARE =

// A connection the build carries, so the app works with no pairing step: set by
// ios/scripts/write-local-config.sh. Empty here: a plain clone opens on the connect screen and is paired
// with `t3bot pair`. In an xcconfig a URL is written https:/$()/host:8809, because // starts a comment.
T3BOT_URL =
T3BOT_TOKEN =

// Only for ios/scripts/install-on-iphone.sh and write-local-config.sh, the route for building on one Mac
// from another. Xcode does not use them. Set them in Local.xcconfig or in the environment:
//   T3BOT_BUILD_HOST   ssh name of the Mac that builds and holds the iPhone pairing.
//   T3BOT_SERVER_HOST  ssh name of the Mac that runs the server and holds its token.
//   T3BOT_BUILD_DIR    folder the build uses on the build Mac, under its home folder.
T3BOT_BUILD_HOST =
T3BOT_SERVER_HOST =
T3BOT_BUILD_DIR = t3bot-build

#include? "Local.xcconfig"
