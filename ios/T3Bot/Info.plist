<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>T3 Bot</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(T3BOT_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>t3bot</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>t3code</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Your bots read your calendar to plan around it, and can propose events you add yourself.</string>
	<key>NSCameraUsageDescription</key>
	<string>T3 Bot uses the camera to scan the pairing code T3 Code shows.</string>
	<key>NSContactsUsageDescription</key>
	<string>Your bots look up who a draft message is for. Nothing is sent without you.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>T3 Bot asks for Face ID before an action you marked as needing it, such as a payment or a release.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>T3 Bot connects to T3 Code, or to your T3 Bot server, when it is on the same network as this phone.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>T3BotAPNSEnv</key>
	<string>$(T3BOT_APNS_ENV)</string>
	<key>T3BotKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(T3BOT_BUNDLE_ID).shared</string>
	<key>T3BotPushHost</key>
	<string>$(T3BOT_PUSH_HOST)</string>
	<key>T3BotToken</key>
	<string>$(T3BOT_TOKEN)</string>
	<key>T3BotURL</key>
	<string>$(T3BOT_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
